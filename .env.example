GEMINI_API_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_IDS=

GOOGLE_LOW_PERFORMANCE_LOOKBACK_DAYS=30
GOOGLE_LOW_PERFORMANCE_MIN_IMPRESSIONS=100
GOOGLE_MAX_REPLACEMENTS_PER_AD=1
CREATIVE_RESERVATION_TTL_MINUTES=30
GOOGLE_APP_AD_REPLACEMENT_ENABLED=1

# Creative review portal
# studio: full internal application; review: public client-review surface only.
APP_MODE=studio
CREATIVE_REVIEW_SHEETS_URL=
CREATIVE_REVIEW_PUBLIC_BASE_URL=
CREATIVE_REVIEW_STUDIO_BASE_URL=
CREATIVE_REVIEW_TOKEN_TTL_DAYS=30
CREATIVE_REVIEW_COOKIE_NAME=cabify_creative_review
CREATIVE_REVIEW_PREVIEW_AUTH_TTL_SECONDS=10
CREATIVE_REVIEW_PUBLISH_LEASE_SECONDS=300
CREATIVE_REVIEW_IMAGE_CONCURRENCY=4
# In production, Studio forwards every review mutation to the public review
# runtime so there is one serialized writer for the Sheet-backed state.
CREATIVE_REVIEW_WRITER_BASE_URL=
CREATIVE_REVIEW_WRITER_SECRET=
CREATIVE_REVIEW_WRITER_TIMEOUT_MS=3600000

# Funnel runs (creative_runs / creative_run_targets)
# Drive folder holding fallback source photos. Used when a low performer's own
# image cannot be downloaded. Leave empty to disable the fallback: targets with
# no usable source are then skipped as "no_source" instead of being generated.
CREATIVE_SOURCE_BANK_FOLDER_ID=
